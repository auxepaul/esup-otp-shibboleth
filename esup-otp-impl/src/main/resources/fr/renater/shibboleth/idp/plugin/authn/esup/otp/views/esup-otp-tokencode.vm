##
## Velocity Template for DisplayEsupOtpTokenCodeView view-state
##
## Velocity context will contain the following properties
## flowExecutionUrl - the form action location
## flowRequestContext - the Spring Web Flow RequestContext
## flowExecutionKey - the SWF execution key (this is built into the flowExecutionUrl)
## profileRequestContext - root of context tree
## authenticationContext - context with authentication request information
## authenticationErrorContext - context with login error state
## authenticationWarningContext - context with login warning state
## rpUIContext - the context with SP UI information from the metadata
## encoder - HTMLEncoder class
## esupOtpEncoder - EsupOtpEncoder class
## cspDigester - Calculates base64-encoded SHA-2 hashes (call apply)
## cspNonce - Calculates secure nonces (call generateIdentifier)
## request - HttpServletRequest
## response - HttpServletResponse
## environment - Spring Environment object for property resolution
## custom - arbitrary object injected by deployer
##
#set ($rpContext = $profileRequestContext.getSubcontext('net.shibboleth.profile.context.RelyingPartyContext'))
##
#set ($esupOtpContext = $authenticationContext.getSubcontext('fr.renater.shibboleth.idp.plugin.authn.esup.otp.context.EsupOtpContext'))
#set ($managerLink = $environment.getProperty("idp.esup.otp.manager.link"))
##
#set ($method = $esupOtpContext.getMethodChoice())
##
#if ("push" == $method || "webauthn" == $method)
  #set ($apiUrl = $environment.getProperty("idp.esup.otp.apiHost"))
#elseif ("totp" == $method || "passcode_grid" == $method || "bypass" == $method || "random_code.sms" == $method || "random_code_mail.mail" == $method)
  #set ($sendCounter = $environment.getProperty('idp.esup.otp.send.counter', -1))
  #set ($codeLength = $environment.getProperty('idp.esup.otp.codeLength', 6))
  #set ($onLoad = "document.getElementById('token').focus()")
#end
##
#set ($nonce = $cspNonce.generateIdentifier())
#set ($onClick = "this.childNodes[0].nodeValue='#springMessageText('idp.login.pleasewait', 'Logging in, please wait...')'")
#set ($onClickResend = "this.childNodes[0].nodeValue='#springMessageText('idp.esup.otp.resend.processed', 'Resend processed, please wait...')'")
#if ("totp" == $method || "passcode_grid" == $method || "bypass" == $method || "random_code.sms" == $method || "random_code_mail.mail" == $method)
$response.addHeader("Content-Security-Policy", "script-src-attr 'unsafe-hashes' 'sha256-$cspDigester.apply($onLoad)' 'sha256-$cspDigester.apply($onClick)' 'sha256-$cspDigester.apply($onClickResend)' 'nonce-$nonce'")
#else
$response.addHeader("Content-Security-Policy", "script-src-attr 'unsafe-hashes' 'sha256-$cspDigester.apply($onClick)' 'sha256-$cspDigester.apply($onClickResend)' 'nonce-$nonce'")
#end
<!DOCTYPE html>
<html>
    <head>
        <title>#springMessageText("idp.title", "Web Login Service")</title>
        <meta charset="UTF-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
        <link rel="stylesheet" type="text/css" href="$request.getContextPath()#springMessageText("idp.css", "/css/placeholder.css")">
        <script src="$request.getContextPath()/js/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="></script>
        #if ("push" == $method)
            <script src="$apiUrl/js/socket.io.js"></script>
            <script type="text/javascript" #if ($nonce)nonce="$nonce"#end>
                // Fonction d'initialisation du socket
                function initializeSocket() {
                    var socket = io.connect("$apiUrl", {
                        reconnect: true,
                        path: "/sockets",
                        query: "uid=${esupOtpContext.getUsername()}&hash=$esupOtpEncoder.getUserHash($esupOtpContext.getUsername())&app=cas"
                    });
                    socket.on('connect', function () {
                        console.log("Socket connect");
                    });
                    socket.on('userAuth', function (data) {
                        if (data.code == "Ok") {
                          submitCode(data.otp);
                        }
                    });
                    socket.on('connect_error', (err) => {
                        console.log('Socket connection error: ' + err.message);
                    });
                }

                function submitCode(code) {
                    document.getElementById("token").value = code;
                    document.getElementById("submitPush").click();
                }

                initializeSocket();
            </script>
            <style #if ($nonce)nonce="$nonce"#end>
                .loader {
                    margin: 8px auto;
                    border: 8px solid #f3f3f3;
                    border-top: 8px solid #0491c6;
                    border-radius: 50%;
                    width: 60px;
                    height: 60px;
                    animation: spin 2s linear infinite;
                }

                @keyframes spin {
                    0% { transform: rotate(0deg); }
                    100% { transform: rotate(360deg); }
                }
            </style>
        #elseif ("webauthn" == $method)
            <script type="module" #if ($nonce)nonce="$nonce"#end>
                import {
                    get,
                    parseRequestOptionsFromJSON,
                    supported,
                } from "$request.getContextPath()/js/webauthn-json.browser-ponyfill.js";

                window.addEventListener("load", () => {
                    try {
                        var isSupported = supported();
                        if (!isSupported) {
                            document.getElementById("authenticate").disabled = true;
                            document.getElementById("authenticator_assertion_form").disabled = true;
                            document.getElementById("error").disabled = false;
                            document.getElementById('error').classList.remove('hidden')
                        } else {
                            document.getElementById("authenticate").onclick = authenticate;
                            document.getElementById("authenticate").click();
                        }
                    } catch (e) {
                        console.error(e);
                    }
                });

                async function authenticate() {
                    // Some UI changes
                    try {
                        document.getElementById('authenticate').textContent='#springMessageText("idp.esup.otp.webauthn.inprogress", "Authenticating...")'
                    } catch (e) {
                        // No issue if this does not work
                    }
                    #if($esupOtpContext.getWebauthnCredentialRequestOptions() && !$esupOtpContext.getWebauthnCredentialRequestOptions().empty) 
                    var pkCredRequestOptions = $esupOtpEncoder.serializePublicKeyCredentialRequestOptionsAsJSON($esupOtpContext.getWebauthnCredentialRequestOptions())
                    var parsedRequestOptions = parseRequestOptionsFromJSON(pkCredRequestOptions);
                    await get(parsedRequestOptions)
                        .then(function (pkCredAssertion) {
                            document.getElementById("publicKeyCredential").value = JSON.stringify(pkCredAssertion);
                            document.getElementById("authenticationSubmit").click();
                        }).catch(function (err) {
                            console.error(err);
                            document.getElementById("authenticate").textContent="#springMessageText('idp.esup.otp.webauthn.retry', 'Login failed, please retry the WebAuthn authentication')"
                        });
                    #else
                    console.error("no webauthn credentials, use another method");
                    document.getElementById("authenticate").textContent="#springMessageText('idp.esup.otp.webauthn.retry', 'Login failed, please retry the WebAuthn authentication')"
                    #end
                }
            </script>
            <style #if ($nonce)nonce="$nonce"#end>
                .hidden {
                    display: none;
                }

                .center {
                    margin-left: auto;
                    margin-right: auto;
                    text-align: center;
                }
            </style>
        #elseif ("totp" == $method || "passcode_grid" == $method || "bypass" == $method || "random_code.sms" == $method || "random_code_mail.mail" == $method)
            <script type="text/javascript" #if ($nonce)nonce="$nonce"#end>
                // Fonction de vérification de la longueur du token
                function validInputLength(addOneChar) {
                    const tokenInputElement = document.getElementById("token");

                    var inputLength = tokenInputElement.value.length;
                    if(addOneChar) {
                        inputLength = inputLength + 1;
                    }

                    return inputLength == $codeLength;
                }

                function disableSubmitButton(disable) {
                    const submitButton = document.getElementById("submitButton");
                    submitButton.disabled = disable;
                }

                // Ajoute l'écouteur d'événement une fois le contenu chargé
                document.addEventListener("DOMContentLoaded", function() {
                    const tokenInputElement = document.getElementById("token");
                    var ctrlDown = false;
                    const ctrlKey = 17, cmdKey = 91, vKey = 86;
                    tokenInputElement.addEventListener('keydown', (e) => {
                        // Backspace, Delete, CTRL+X : disable Submit
                        if (e.key == "Backspace" || e.key == "Delete" || (e.keyCode == 88 && (e.ctrlKey === true || e.metaKey === true)) ) {
                            disableSubmitButton(true);
                        }
                        // Allow: backspace, delete, tab, escape, enter and .
                        if ($.inArray(e.keyCode, [46, 8, 9, 27, 13, 110, 190]) !== -1 ||
                          // Allow: Ctrl+A,Ctrl+C,Ctrl+V, Command+A
                          ((e.keyCode == 65 || e.keyCode == 86 || e.keyCode == 67) && (e.ctrlKey === true || e.metaKey === true)) ||
                          // Allow: home, end, left, right, down, up
                          (e.keyCode >= 35 && e.keyCode <= 40)) {
                          // let it happen, don't do anything
                          return;
                        }
                        // prevent if token size is over
                        if (validInputLength(false)) {
                            e.preventDefault();
                        }
                        // prevent if input is not number
                        if (!ctrlDown && e.key.length == 1 && /[^0-9]/.test(e.key)) {
                            e.preventDefault();
                        }
                    });
                    $('input').bind('paste',function(e){
                        var $this = $(this);
                        setTimeout(function(){
                            if(/[0-9]{${codeLength}}/.test($this.val())) {
                                disableSubmitButton(false);
                            }
                        },0); //just break the callstack to let the event finish
                    });
                    tokenInputElement.addEventListener('keypress', (e) => {
                        if (e.key == "Enter") {
                            e.preventDefault();
                            const validCode = validInputLength(false);
                            if(validCode) {
                                document.getElementById("submitButton").click();
                            }
                        } else {
                            const validCode = validInputLength(true);
                            disableSubmitButton(!validCode);
                        }
                    });
                    tokenInputElement.addEventListener('change', (e) => {
                            e.preventDefault();
                            const validCode = validInputLength(false);
                            disableSubmitButton(!validCode);
                    });

                    #if ("random_code.sms" == $method || "random_code_mail.mail" == $method)
                    var canRetry = true;
                    const maxRetry = $sendCounter;
                    if(maxRetry != -1) {
                        canRetry = $esupOtpContext.getSendCounter() <= maxRetry;
                    }
                    document.getElementById("retryButton").disabled = !canRetry;
                    #end
                });
            </script>
            <style #if ($nonce)nonce="$nonce"#end>
                @media all {
                    .input-wrap {
                        position: relative;
                        display: flex;
                        padding: 0px;
                    }

                    .input-wrap.token {
                        width: 300px;
                        margin-bottom: 10px;
                        column-gap: 10px;
                    }

                    .token-input {
                        position: absolute;
                        left: 0px;
                        top: 0px;
                        z-index: 2;
                        min-width: calc(55px * ${codeLength});
                        height: 50px;
                        margin-bottom: 0px;
                        padding: 0px 0px 0px 12px !important;
                        border-style: none;
                        border-width: 0px !important;
                        border-color: transparent !important;
                        background-color: transparent !important;
                        font-family: Verdana, Geneva, sans-serif;
                        color: rgb(0, 0, 0);
                        font-size: 23px;
                        font-weight: 400;
                        text-align: left;
                        letter-spacing: 35.5px;
                        text-transform: uppercase;
                        overflow: hidden;
                    }

                    .token-input:hover ~ .one-input {
                        border-color: #0491c6;
                        box-shadow: none;
                    }

                    .one-input {
                        position: relative;
                        min-height: 40px;
                        margin-bottom: 20px;
                        padding: 8px 12px;
                        border-style: solid;
                        border-width: 1px;
                        border-color: rgba(18, 19, 49, 0.25);
                        border-radius: 5px;
                        background-color: white;
                        box-shadow: rgba(0, 0, 0, 0.1) 0px 5px 10px -5px;
                        transition-property: box-shadow, border-color;
                        transition-duration: 200ms, 200ms;
                        transition-timing-function: ease, ease;
                        color: rgb(18, 19, 49);
                    }

                    .token-fake {
                        width: 40px;
                        height: 50px;
                        background-color: transparent;
                    }

                }

                .input {
                    display: block;
                    line-height: 1.42857143;
                    box-shadow: none;
                }

                .input:focus {
                    outline: 0;
                    background-color: transparent;
                    border: none;
                    box-shadow: none;
                }

                .input:focus ~ .one-input {
                    border-color: #0491c6;
                    box-shadow: none;
                }

                .token-overflow {
                    z-index: 5;
                    width: 30px;
                    height: 50px;
                    background-color: #fff;
                    position: absolute;
                    top: 0%;
                    left: 100%;
                    right: auto;
                }
            </style>
        #end
    </head>
    <body #if ("totp" == $method || "passcode_grid" == $method || "bypass" == $method || "random_code.sms" == $method || "random_code_mail.mail" == $method) onLoad="$onLoad" #end>
        <main class="main">
            <header>
                <img class="main-logo" src="$request.getContextPath()#springMessageText("idp.logo", "/images/placeholder-logo.png")" alt="#springMessageText("idp.logo.alt-text", "logo")" />

                #set ($serviceName = $rpUIContext.serviceName)
                #if ($serviceName && !$rpContext.getRelyingPartyId().contains($serviceName))
                    <h1>#springMessageText("idp.login.loginTo", "Login to") $encoder.encodeForHTML($serviceName)</h1>
                #end
            </header>

            <section>
                #*
                //
                //    SP Description & Logo (optional)
                //    These idpui lines will display added information (if available
                //    in the metadata) about the Service Provider (SP) that requested
                //    authentication. These idpui lines are "active" in this example
                //    (not commented out) - this extra SP info will be displayed.
                //    Remove or comment out these lines to stop the display of the
                //    added SP information.
                //
                *#
                #set ($logo = $rpUIContext.getLogo())
                #if ($logo)
                    <img class="service-logo" src= "$encoder.encodeForHTMLAttribute($logo)" alt="$encoder.encodeForHTMLAttribute($serviceName)">
                #end
                #set ($desc = $rpUIContext.getServiceDescription())
                #if ($desc)
                    <p>$encoder.encodeForHTML($desc)</p>
                #end

                #parse("esup-otp-error.vm")

                #if ("push" == $method)
                    <form id="pushForm" action="$flowExecutionUrl" method="post">
                        #parse("csrf/csrf.vm")
                        <input type="hidden" id="token" name="token" type="text" value="" />
                        <button id="submitPush" style="display: none;" type="submit" name="_eventId_proceed"
                                onClick="$onClick">#springMessageText("idp.esup.otp.send", "Send")</button>
                    </form>

                    <article>
                        <p class="output-message output--warning">
                            #springMessageText("idp.esup.otp.push.wait", "Waiting the validation on your device...")
                        </p>
                        <div class="loader"></div>
                    </article>
                    <article>
                        <button class="button float-left" type="submit" name="_eventId_resend" id="retryButton"
                                onClick="$onClickResend">#springMessageText("idp.esup.otp.push.resend", "Resend push notification")</button>
                    </article>
                #elseif ("webauthn" == $method)
                    <form id="authenticator_assertion_form" action="$flowExecutionUrl" method="post">
                        #parse("csrf/csrf.vm")
                        <input type="hidden" id="publicKeyCredential" name="publicKeyCredential" />
                        <button class="hidden" id="authenticationSubmit" type="submit"
                                name="_eventId_proceed">#springMessageText("idp.esup.otp.webauthn.submit", "Submit authentication")</button>
                    </form>
                    <div class="center">
                        <button class="button" id="authenticate">#springMessageText("idp.esup.otp.webauthn.authenticate", "Login with a passkey or a security key (WebAuthn)")</button>
                    </div>

                    <article id="error" class="hidden">
                        <p class="output-message output--error">
                            #springMessageText("idp.esup.otp.error", "Initialization 2FA exception occured.")
                            <br/><br/>
                            #springMessageText("idp.esup.otp.try.another.method", "Please try another method.")
                        </p>
                    </article>
                #elseif ("totp" == $method || "passcode_grid" == $method || "bypass" == $method || "random_code.sms" == $method || "random_code_mail.mail" == $method)
                    <form action="$flowExecutionUrl" method="post">
                        #parse("csrf/csrf.vm")

                        <fieldset class="margin-top">
                        #if ("bypass" == $method)
                            <label for="token">#springMessageText("idp.esup.otp.token.label.bypass", "Please enter one of your unused backup codes:")</label>
                        #elseif ("totp" == $method)
                            <label for="token">#springMessageText("idp.esup.otp.token.label.totp", "Please enter the code displayed on your TOTP application:")</label>
                        #elseif ("passcode_grid" == $method)
                            #set ($line = $esupOtpContext.getPasscodeGridChallenge().getLine())
                            #set ($column = $esupOtpContext.getPasscodeGridChallenge().getColumn())
                            <label for="token">$springMacroRequestContext.getMessage('idp.esup.otp.token.label.passcode_grid', [${line},${column}], 'Enter the code shown in the cell at the intersection of line ${line} and column ${column} of your passcode grid:')</label>
                        #else
                            <label for="token">#springMessageText("idp.esup.otp.token.label.random_code", "Please enter the received code:")</label>
                        #end

                            <div class="input-wrap token">
                                <input class="form-element form-field token-input input" id="token" name="token" type="text"
                                       inputmode="numeric" minlength="${codeLength}" maxlength="${codeLength}" pattern="[0-9]{${codeLength}}"
                                       accesskey="m" placeholder="000000" tooltip="$springMacroRequestContext.getMessage('idp.esup.otp.token.placeholder', [${codeLength}], 'Enter the ${codeLength}')" autocomplete="one-time-code" />
                            #foreach($unused in [1..$codeLength])
                                <div class="one-input token-fake"></div>
                            #end
                                <div class="token-overflow"></div>
                            </div>

                        #if ("random_code.sms" == $method || "random_code_mail.mail" == $method)
                            <button class="button float-left" type="submit" name="_eventId_resend" id="retryButton"
                                    onClick="$onClickResend">#springMessageText("idp.esup.otp.resend", "Resend")</button>
                        #end

                            <button class="button float-right" type="submit" name="_eventId_proceed" id="submitButton"
                                    disabled onClick="$onClick">#springMessageText("idp.esup.otp.send", "Send")</button>
                        </fieldset>
                    </form>
                #else
                    <article>
                        <p class="output-message output--warning">
                            #springMessageText("idp.esup.otp.nochoices", "You have no registered authentication method.")
                            <br/><br/>
                            #springMessageText("idp.esup.otp.nochoices.activate","To access this service, activate the multi-factor authentication ") <a href='${managerLink}' target='_blank'>#springMessageText("idp.esup.otp.nochoices.here","here")</a>.
                        </p>
                    </article>
                #end
                <ul>
                    <li><a href="${managerLink}">#springMessageText("idp.esup.otp.updatechoices", "Update your authentication choices?")</a></li>
                    <li><a href="#springMessageText("idp.url.password.reset", '#')">#springMessageText("idp.login.forgotPassword", "Forgot your password?")</a></li>
                    <li><a href="#springMessageText("idp.url.helpdesk", '#')">#springMessageText("idp.login.needHelp", "Need Help?")</a></li>
                </ul>
            </section>
        </main>
        <footer class="footer">
            <div class="cc">
                <p>#springMessageText("idp.footer", "Insert your footer text here.")</p>
            </div>
        </footer>
     </body>
</html>
